{
  "format": "clipkin.runtime-local@1",
  "dataRoot": ".clipkin/runtimes/local",
  "credentials": {
    "local": {
      "use": "@clipkin/credential-store-local"
    }
  },
  "endpoints": {
    "replicate.default": {
      "use": "@clipkin/provider-replicate",
      "config": {
        "apiKey": {
          "store": "local",
          "key": "replicate.api-key"
        }
      }
    },
    "elevenlabs.default": {
      "use": "@clipkin/provider-elevenlabs",
      "config": {
        "apiKey": {
          "store": "local",
          "key": "elevenlabs.api-key"
        }
      }
    },
    "fishaudio.default": {
      "use": "@clipkin/provider-fishaudio",
      "config": {
        "apiKey": {
          "store": "local",
          "key": "fishaudio.api-key"
        }
      }
    },
    "mimo.default": {
      "use": "@clipkin/provider-mimo",
      "config": {
        "apiKey": {
          "store": "local",
          "key": "mimo.api-key"
        }
      }
    },
    "volcengine.default": {
      "use": "@clipkin/provider-volcengine",
      "config": {
        "apiKey": {
          "store": "local",
          "key": "volcengine.api-key"
        }
      }
    },
    "media.local": {
      "use": "@clipkin/media-local",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "html.local": {
      "use": "@clipkin/provider-html-local",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1
      }
    }
  },
  "bindings": {
    "@clipkin/whisperx@1#whisperx-alignment": "replicate.default"
  }
}
