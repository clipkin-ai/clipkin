{
  "format": "clipkin.runtime-local@1",
  "dataRoot": ".clipkin/runtimes/local",
  "credentials": {
    "local": {
      "use": "@clipkin/credential-store-local"
    }
  },
  "endpoints": {
    "clipkin.default": {
      "use": "@clipkin/provider-clipkin",
      "config": {
        "apiKey": {
          "store": "local",
          "key": "clipkin.account"
        }
      }
    },
    "media.local": {
      "use": "@clipkin/media-local",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "html.local": {
      "use": "@clipkin/provider-html-local",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1
      }
    }
  },
  "bindings": {
    "@clipkin/whisperx@1#whisperx-alignment": "clipkin.default"
  }
}
