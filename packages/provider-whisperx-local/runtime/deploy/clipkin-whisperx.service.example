[Unit]
Description=Reel WhisperX alignment service
After=network.target

[Service]
Type=simple
User=clipkin
WorkingDirectory=/opt/clipkin
Environment=CLIPKIN_WHISPERX_PORT=8765
Environment=CLIPKIN_WHISPERX_MODEL=small
Environment=CLIPKIN_WHISPERX_DEVICE=cpu
Environment=CLIPKIN_WHISPERX_COMPUTE=int8
Environment=CLIPKIN_WHISPERX_BATCH_SIZE=8
Environment=CLIPKIN_WHISPERX_INPUT_ROOTS=/tmp
Environment=CLIPKIN_WHISPERX_NLTK_DATA=/var/cache/clipkin/whisperx/nltk_data
Environment=OMP_NUM_THREADS=2
Environment=TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
ExecStartPre=/opt/clipkin/packages/provider-whisperx-local/runtime/.venv/bin/clipkin-whisperx-check
ExecStart=/opt/clipkin/packages/provider-whisperx-local/runtime/.venv/bin/clipkin-whisperx-service
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
