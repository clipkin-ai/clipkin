<?reel using="@clipkin/recipe@1"?>

<sheet version="1" id="caption-styles">
  /*
  The named caption styles shown in Clipkin's public caption gallery. Each recipe is a complete Fine
  Caption treatment for a 1080-pixel-wide vertical video; its font, Cue length and how to use it are
  in caption-styles.md. Copy a recipe into the project's own .grade under the project's own path
  (for example caption.primary) and adjust placement there.
  */

  /* ---- One word at a time: write one word per Cue (word || word || word). ---- */

  caption.ticker {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.9;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    size: 168;
    line-height: 1;
    letter-spacing: 1;
    text-transform: uppercase;
    fill: #FFFFFF;
    stroke-color: #000000;
    stroke-width: 7;
    shadow-color: #000000;
    shadow-opacity: 0.55;
    shadow-x: 0;
    shadow-y: 8;
    shadow-blur: 14;
    background: #00000000;
    padding: "0";
    radius: 0;
    cue-enter: pop;
    cue-enter-frames: 4;
    cue-exit: none;
    lead-frames: 0;
    tail-frames: 2;
    handoff: cut;
  }

  caption.stamp {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.9;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: hug;
    size: 116;
    line-height: 1.05;
    text-transform: uppercase;
    fill: #121212;
    background: #FFE14D;
    padding: "16 34";
    radius: 6;
    cue-shadow-color: #000000;
    cue-shadow-opacity: 0.4;
    cue-shadow-x: 10;
    cue-shadow-y: 12;
    cue-shadow-blur: 0;
    cue-enter: stamp;
    cue-enter-frames: 5;
    cue-exit: none;
    lead-frames: 0;
    tail-frames: 2;
    handoff: cut;
  }

  caption.scribble {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.9;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    size: 176;
    line-height: 1;
    fill: #FFFFFF;
    long-shadow-color: #FF3D7F;
    long-shadow-opacity: 1;
    long-shadow-angle: 45;
    long-shadow-distance: 10;
    background: #00000000;
    padding: "0";
    radius: 0;
    cue-enter: tilt;
    cue-enter-frames: 5;
    cue-exit: fade;
    cue-exit-frames: 2;
    lead-frames: 0;
    tail-frames: 2;
    handoff: cut;
  }

  /* ---- Builds up: each word appears as it is spoken. Write three or four words per Cue. ---- */

  caption.stack {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.86;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: fixed;
    wrap: word;
    max-lines: 2;
    max-words-per-line: 2;
    size: 90;
    line-height: 1.04;
    word-gap: 22;
    text-transform: uppercase;
    fill: #FFFFFF;
    shadow-color: #000000;
    shadow-opacity: 0.7;
    shadow-x: 0;
    shadow-y: 6;
    shadow-blur: 0;
    background: #00000000;
    padding: "0";
    radius: 0;
    atom-reveal: on-start;
    atom-enter: slide-up;
    atom-enter-frames: 4;
    slide-distance: 40;
    cue-exit: fade;
    cue-exit-frames: 3;
    lead-frames: 0;
    tail-frames: 6;
    handoff: cut;
  }

  caption.typewriter {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.86;
    anchor-x: center;
    anchor-y: center;
    align: left;
    block-align: center;
    inline-size: hug;
    wrap: word;
    max-lines: 2;
    max-words-per-line: 3;
    size: 64;
    line-height: 1.3;
    word-gap: 18;
    fill: #B6FFB0;
    background: #0B0F0BE6;
    padding: "18 28";
    radius: 10;
    atom-reveal: typewriter;
    cue-enter: fade;
    cue-enter-frames: 2;
    cue-exit: fade;
    cue-exit-frames: 3;
    lead-frames: 0;
    tail-frames: 8;
    handoff: cut;
  }

  /* ---- Word highlight: the whole line is readable and the spoken word is marked. ---- */

  caption.neon {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.86;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: fixed;
    wrap: word;
    max-lines: 2;
    max-words-per-line: 3;
    size: 78;
    line-height: 1.12;
    word-gap: 18;
    fill: #FFFFFF;
    stroke-color: #000000;
    stroke-width: 3;
    background: #00000000;
    padding: "0";
    radius: 0;
    karaoke: current;
    karaoke-transition: step;
    active-fill: #4DF2FF;
    active-glow-color: #4DF2FF;
    active-glow-opacity: 0.85;
    active-glow-blur: 18;
    active-glow-spread: 2;
    active-response: pop;
    active-response-frames: 4;
    cue-enter: pop;
    cue-enter-frames: 3;
    cue-exit: none;
    lead-frames: 0;
    tail-frames: 6;
    handoff: cut;
  }

  caption.highlighter {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.86;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: fixed;
    wrap: word;
    max-lines: 2;
    max-words-per-line: 3;
    size: 76;
    line-height: 1.2;
    word-gap: 20;
    fill: #FFFFFF;
    shadow-color: #000000;
    shadow-opacity: 0.6;
    shadow-y: 4;
    shadow-blur: 8;
    background: #00000000;
    padding: "0";
    radius: 0;
    karaoke: current;
    karaoke-transition: step;
    active-fill: #FFFFFF;
    active-box: current;
    active-box-background: #FF2E88;
    active-box-radius: 14;
    active-box-padding: "6 16";
    active-box-transition-frames: 3;
    active-shadow-opacity: 0;
    cue-enter: fade;
    cue-enter-frames: 3;
    cue-exit: none;
    lead-frames: 0;
    tail-frames: 6;
    handoff: cut;
  }

  caption.marker {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.86;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: fixed;
    wrap: word;
    max-lines: 2;
    max-words-per-line: 3;
    size: 80;
    line-height: 1.18;
    word-gap: 18;
    fill: #FFFFFF;
    background: #00000000;
    padding: "0";
    radius: 0;
    karaoke: trail;
    karaoke-transition: step;
    active-fill: #121212;
    active-box: trail;
    active-box-continuity: joined;
    active-box-background: #FFD400;
    active-box-radius: 6;
    active-box-padding: "4 12";
    cue-enter: fade;
    cue-enter-frames: 3;
    cue-exit: fade;
    cue-exit-frames: 2;
    lead-frames: 0;
    tail-frames: 6;
    handoff: cut;
  }

  caption.singalong {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.86;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: fixed;
    wrap: word;
    max-lines: 2;
    max-words-per-line: 4;
    size: 74;
    line-height: 1.16;
    word-gap: 16;
    fill: #FFFFFF8C;
    stroke-color: #000000;
    stroke-width: 2;
    background: #00000000;
    padding: "0";
    radius: 0;
    karaoke: trail;
    karaoke-transition: wipe;
    active-fill: #FFC94D;
    active-stroke-color: #000000;
    active-stroke-width: 2;
    cue-enter: fade;
    cue-enter-frames: 3;
    cue-exit: fade;
    cue-exit-frames: 3;
    lead-frames: 2;
    tail-frames: 8;
    handoff: cut;
  }

  /* ---- Full line: the phrase arrives whole and stays still. ---- */

  caption.subtitle {
    stack-order: 70;
    x: 0.5;
    y: 0.8;
    width: 0.88;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: hug;
    wrap: word;
    max-lines: 2;
    max-words-per-line: 3;
    size: 50;
    line-height: 1.3;
    word-gap: 13;
    fill: #FFFFFF;
    background: #000000B3;
    padding: "12 22";
    radius: 12;
    cue-enter: fade;
    cue-enter-frames: 3;
    cue-exit: fade;
    cue-exit-frames: 3;
    lead-frames: 2;
    tail-frames: 6;
    handoff: cut;
  }

  caption.cinema {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.86;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: fixed;
    wrap: word;
    size: 92;
    line-height: 1.08;
    word-gap: 20;
    fill: #F6E7C8;
    shadow-color: #000000;
    shadow-opacity: 0.75;
    shadow-y: 4;
    shadow-blur: 18;
    background: #00000000;
    padding: "0";
    radius: 0;
    cue-enter: blur-in;
    cue-enter-frames: 8;
    cue-exit: fade;
    cue-exit-frames: 5;
    lead-frames: 3;
    tail-frames: 8;
    handoff: cut;
  }

  caption.bubble {
    stack-order: 70;
    x: 0.5;
    y: 0.62;
    width: 0.86;
    anchor-x: center;
    anchor-y: center;
    align: center;
    block-align: center;
    inline-size: hug;
    wrap: word;
    max-lines: 1;
    max-words-per-line: 3;
    size: 64;
    line-height: 1.18;
    word-gap: 15;
    fill: #161616;
    background: #FFFFFF;
    padding: "18 34";
    radius: 44;
    cue-shadow-color: #000000;
    cue-shadow-opacity: 0.35;
    cue-shadow-y: 10;
    cue-shadow-blur: 24;
    cue-enter: spring;
    cue-enter-frames: 6;
    cue-enter-start-scale: 0.6;
    cue-exit: scale;
    cue-exit-frames: 3;
    lead-frames: 0;
    tail-frames: 4;
    handoff: cut;
  }
</sheet>
